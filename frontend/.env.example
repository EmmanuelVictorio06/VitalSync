# Frontend (Vite) — copie para frontend/.env.local e preencha com os valores
# do seu projeto Supabase (Project Settings → API).
#
# Regras: sem aspas, sem espaços ao redor do "=", use APENAS a chave pública
# "anon" (ou "publishable"). NUNCA a "service_role" no frontend.
VITE_SUPABASE_URL=https://seu-projeto.supabase.co
VITE_SUPABASE_ANON_KEY=sua-chave-anon-publica

# URL pública do app (usada para montar o link do paciente no WhatsApp).
# Local: http://localhost:5173 · Vercel: o domínio de produção (Settings →
# Environment Variables, escopo Production). Evite domínios de preview
# protegidos (*-git-*.vercel.app).
VITE_PUBLIC_APP_URL=http://localhost:5173

# ===== Homologação médica (semana de testes) =====
# Fixa o modo de homologação já na build (deploy dedicado de testes). O badge
# "Ambiente de teste" também é ligado em runtime pelo Admin (banco). Em
# produção real, deixe "production"/"false".
VITE_APP_ENV=production
VITE_HOMOLOGATION_MODE=false

# ===== Suporte técnico (tela pública do paciente) =====
# Exibido no rodapé do fluxo de medição do paciente para relato de problema
# técnico. Opcional — sem estes valores, um placeholder aparece (ver
# frontend/src/config/support.ts). TODO: preencher com o contato real antes
# de liberar para pacientes reais.
#
# VITE_SUPPORT_CONTACT_PHONE também é o telefone humano mostrado quando a tela
# do paciente quebra (ErrorBoundary). Sem ele, a linha do telefone é OMITIDA no
# fallback — o paciente fica sem para quem ligar.
VITE_SUPPORT_CONTACT_EMAIL=
VITE_SUPPORT_CONTACT_PHONE=

# ===== WhatsApp oficial (aviso antigolpe) =====
# Número pelo qual a enfermagem faz contato ativo com o paciente. Mostrado a ele
# no primeiro acesso e após cada medição, para que a ligação não seja confundida
# com golpe. DEVE ser o mesmo número verificado usado pelas Edge Functions.
# Sem este valor, o aviso aparece sem o número (nunca com placeholder falso).
# Ver docs/AVISO_CONTATO_ATIVO.md.
VITE_WHATSAPP_OFICIAL=

# ===== Versão do app (diagnóstico de erro) =====
# Gravada em client_error_logs para correlacionar erro com deploy. Na Vercel,
# pode receber o SHA do commit. Opcional.
VITE_APP_VERSION=
