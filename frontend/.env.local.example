# Frontend (Vite) — copie para frontend/.env.local e preencha com os valores
# do seu projeto Supabase (Project Settings → API).
#
# Use APENAS a chave pública "anon". NUNCA a "service_role" no frontend.
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...sua-anon-key...

# Domínio PÚBLICO de PRODUÇÃO usado para montar o link do paciente (WhatsApp).
# Defina na Vercel (Settings → Environment Variables, escopo Production) com o
# domínio de produção — NUNCA um domínio de preview protegido (*-git-*.vercel.app).
# Em dev local pode deixar em branco: cai em window.location.origin.
# Ex.: https://vital-sync-frontend.vercel.app  (ou o domínio próprio)
VITE_PUBLIC_APP_URL=
