# ===== Backend =====
NODE_ENV=development
PORT=3333

# Database (matches docker-compose.yml)
DATABASE_URL="postgresql://vitalsync:vitalsync@localhost:5544/vitalsync?schema=public"

# Auth — TROQUE em produção por um segredo forte (>= 32 chars)
JWT_SECRET="dev-change-me-please-32-chars-minimum-secret"
JWT_EXPIRES_IN="8h"
# Tempo (horas) de validade extra do link do paciente após o fim do monitoramento
PATIENT_LINK_GRACE_HOURS=24

# Base pública usada para montar o link do paciente enviado por WhatsApp
PUBLIC_WEB_URL="http://localhost:5173"

# Diretório (fora do webroot) onde as fotos da ferida são salvas com segurança
UPLOADS_DIR="./uploads"

# Seed do ADM inicial
ADMIN_EMAIL="admin@vitalsync.local"
ADMIN_PASSWORD="Admin@123"
ADMIN_NAME="Administrador"

# ===== WhatsApp (adapter desacoplado) =====
# Provedor: "log" (desenvolvimento, apenas registra), "twilio", "meta"
WHATSAPP_PROVIDER="log"
# WHATSAPP_API_TOKEN=""
# WHATSAPP_FROM_NUMBER=""

# ===== Frontend (Vite) =====
VITE_API_URL="http://localhost:3333"
