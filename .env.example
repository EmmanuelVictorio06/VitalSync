# ===== Backend =====
NODE_ENV=development
PORT=3333

# Database (matches docker-compose.yml)
DATABASE_URL="postgresql://vitalsync:vitalsync@localhost:5544/vitalsync?schema=public"

# Auth — TROQUE em produção por um segredo forte (>= 32 chars)
JWT_SECRET="dev-change-me-please-32-chars-minimum-secret"
JWT_EXPIRES_IN="8h"
# Tempo (horas) de validade extra do link do paciente após o fim do monitoramento
PATIENT_LINK_GRACE_HOURS=24

# Base pública usada para montar o link do paciente enviado por WhatsApp
PUBLIC_WEB_URL="http://localhost:5173"

# Diretório (fora do webroot) onde as fotos da ferida são salvas com segurança
UPLOADS_DIR="./uploads"

# Seed do ADM inicial
ADMIN_EMAIL="admin@vitalsync.local"
ADMIN_PASSWORD="Admin@123"
ADMIN_NAME="Administrador"

# ===== WhatsApp (adapter desacoplado) =====
# Provedor: "log" (desenvolvimento, apenas registra), "twilio", "meta"
WHATSAPP_PROVIDER="log"
# WHATSAPP_API_TOKEN=""
# WHATSAPP_FROM_NUMBER=""

# ===== WhatsApp Cloud API (Meta) — Edge Functions / Supabase secrets =====
# Configure como SECRETS no Supabase (nunca no frontend):
#   supabase secrets set WHATSAPP_API_TOKEN=... WHATSAPP_PHONE_NUMBER_ID=... \
#     WHATSAPP_VERIFY_TOKEN=... WHATSAPP_TEMPLATE_NAME=alerta_clinico_vitalsync
WHATSAPP_API_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
# Token (string à sua escolha) para validar o webhook de status da Meta.
WHATSAPP_VERIFY_TOKEN=""
# Template aprovado (pt_BR) usado nos alertas automáticos.
WHATSAPP_TEMPLATE_NAME="alerta_clinico_vitalsync"
WHATSAPP_TEMPLATE_LANG="pt_BR"

# ===== CPF do paciente (Edge Functions / Supabase secrets) =====
# Dado sensível: o CPF nunca é gravado em texto puro. A Edge Function
# `create-patient` calcula o hash (HMAC) e a cifra (AES-GCM) usando estes
# segredos — configure-os como SECRETS no Supabase (nunca no frontend):
#   supabase secrets set CPF_PEPPER=<string-forte-e-estavel> \
#     CPF_ENC_KEY=<outra-string-forte-e-estavel>
# Gere com, por exemplo: openssl rand -hex 32
# ATENÇÃO: se trocar o CPF_PEPPER depois, os hashes antigos deixam de bater.
CPF_PEPPER=""
CPF_ENC_KEY=""

# ===== Homologação médica (semana de testes) =====
# O GATE real fica na tabela homologation_settings (ligado pelo Admin em
# Configurações → Homologação) e é lido pela função SQL notify_team_of_alert.
# Estas variáveis são referência/legado — a lista efetiva fica no banco.
HOMOLOGATION_MODE=false
WHATSAPP_TEST_RECIPIENTS=5541999999999,5541888888888

# ===== Frontend (Vite) =====
VITE_API_URL="http://localhost:3333"
